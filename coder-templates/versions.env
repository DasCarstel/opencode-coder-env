#!/bin/bash
# versions.env – Versions-Pins für die Coder-Workspaces.
#
# Wird von coder-templates/shared/startup.sh geladen. Die Datei lebt im Repo:
# Update-Ablauf = eine Version anpassen, commit + push → beim nächsten
# Workspace-Start ziehen ALLE Container automatisch und identisch nach.
#
# Strategie (Hybrid, 2026-10-12 entschieden):
#   - OpenCode: KEIN Pin – startup.sh gleicht bei jedem Start auf npm-latest ab.
#   - Alles andere: hier gepinnt. Fehlt die Datei, warnen die Blöcke und die
#     bisherig installierte Version bleibt unverändert.
#
# Veraltete Pins anzeigen: scripts/check-updates.sh (read-only).

SSH_MCP_VERSION=2.19.1
OCIS_MCP_VERSION=1.1.0
HERDR_VERSION=0.9.5
DCP_VERSION=3.2.0

# Bake-Baseline: Default des ARG OPENCODE_VERSION in den vier Dockerfiles.
# Das ist NUR der Startwert für das Image – die Laufzeit bleibt ungepinnt:
# shared/startup.sh gleicht bei jedem Start gegen npm-latest ab und
# installiert bei Bedarf nach. Abgleich Dockerfile ↔ hier: check-updates.sh.
OPENCODE_VERSION=2.0.32
