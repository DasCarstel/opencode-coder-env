// Ausfallschutz-Einstellungen (SOT des Hestia-Panels).
// Geschrieben über POST /api/failover/settings, gelesen von hestia/backend/failover.py.
// quarantineHours: 0 schaltet die Modell-Quarantäne ab.
{
  "enabled": true,
  "threshold": 2,
  "intervalSeconds": 10800,
  "timeoutSeconds": 35,
  "quarantineHours": 6
}
