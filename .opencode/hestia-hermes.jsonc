{
  "enabled": true,
  "primary": {
    "provider": "opencode-go",
    "model": "beam-free"
  },
  "fallback": [
    {
      "provider": "opencode-go",
      "model": "glm-5.3-flash"
    },
    {
      "provider": "opencode-go",
      "model": "longcat-2.5-preview-free"
    }
  ],
  "pool": {
    "followActive": true,
    "onlyActiveWhenExpiring": false
  },
  "api_server": {
    "enabled": true,
    "port": 8642,
    "host": "0.0.0.0"
  },
  "restart": true,
  "profiles": {
    "kleve": {
      "enabled": true
    }
  },
  // Erweiterte Sektionen (Hermes Voice): Das Panel schickt sie nicht mit —
  // hermes.py traegt sie beim Apply von der aktuellen SOT weiter (Deep-Merge,
  // z. B. bleibt platforms.ntfy erhalten) und apply-hermes.sh merged sie per
  // Deep-Merge in die config.yaml im Container (alles andere bleibt unangetastet).
  "agent": {
    "reasoning_effort": "low",
    "api_max_retries": 1,
    "auto_recovery_cycles": 0
  },
  "providers": {
    "opencode-go": {
      "request_timeout_seconds": 25,
      "stale_timeout_seconds": 20
    }
  },
  "platform_toolsets": {
    // API/Voice: Notion läuft über /opt/data/bin/notion_fast.py (terminal),
    // nicht über den 65-Tool-MCP-Server. HA und oCIS bleiben als MCP verfügbar;
    // Super Productivity und MuellerConnect bleiben auf CLI/PC.
    "api_server": ["web", "todo", "memory", "clarify", "skills", "terminal", "mcp-homeassistant", "mcp-ocis-private"]
  },
  "platforms": {},
  // Deaktivierte Skills (Hermes Voice): Alles, was nicht gebraucht wird, ist
  // hier aus — aktiv bleiben space-matrix, notion-database, model-curator,
  // hermes-agent, hermes-agent-skill-authoring, maps, grounded-citations,
  // blocked-page-recovery und obsidian-ocis (hestia/skills/obsidian-ocis).
  // apply-hermes.sh ersetzt die Liste 1:1 in der config.yaml (Listen werden
  // im Deep-Merge ersetzt, nie konkateniert).
  "skills": {
    "disabled": [
      "airtable", "architecture-diagram", "arxiv", "ascii-video", "baoyu-infographic",
      "box", "claude-code", "claude-design", "codebase-inspection", "codex",
      "competitor-news-monitor", "computer-use", "design-md", "document-to-action-items",
      "docx", "dogfood", "email-inbox-triage", "gif-search", "github",
      "google-workspace", "himalaya", "humanizer", "inspecting-hermes-desktop-dom",
      "llm-wiki", "manim-video", "meeting-action-items", "node-inspect-debugger",
      "notion", "obsidian", "opencode", "p5js", "pdf", "popular-web-designs",
      "powerpoint", "product-price-monitor", "python-debugpy", "requesting-code-review",
      "simplify-code", "songsee", "songwriting-and-ai-music", "spike",
      "systematic-debugging", "teams-meeting-pipeline", "test-driven-development",
      "weekly-review-planning", "xlsx", "xurl", "youtube-content"
    ]
  }
}
