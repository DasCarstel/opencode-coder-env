{
  "enabled": true,
  "primary": {
    "provider": "opencode-go",
    "model": "deepseek-v4.1-flash"
  },
  "fallback": [
    {
      "provider": "opencode-go",
      "model": "gpt-6-luna"
    },
    {
      "provider": "opencode-go",
      "model": "mimo-v2.6-flash"
    }
  ],
  "pool": {
    "followActive": true,
    "onlyActiveWhenExpiring": false
  },
  "restart": true,
  // API-Server von Hermes (schreibt apply-hermes.sh nach /opt/data/.env).
  // API_SERVER_KEY ist ein Secret und bleibt bewusst ausserhalb der SOT.
  "api_server": {
    "enabled": true,
    "port": 8642,
    "host": "0.0.0.0"
  },
  // "kleve" setzt bewusst NICHTS Eigenes: apply-hermes.sh erbt Primary, Fallbacks
  // und Pool vom Top-Level ("jedes erbt vom Top-Level, was es nicht selbst setzt").
  // Damit nutzt Kleve genau dasselbe wie das Default-Profil und folgt kuenftigen
  // Aenderungen automatisch. Vorher stand hier primary=glm-5.3-flash — laut Log
  // seit dem 10.10.2026 unbenutzt, und es band das Profil an ein eingefrorenes Modell.
  "profiles": {
    "kleve": {
      "enabled": true
    }
  }
}
