{
  "enabled": true,
  "primary": {
    "provider": "opencode-go",
    "model": "deepseek-v4.1-flash-free"
  },
  "fallback": [
    {
      "provider": "opencode-go",
      "model": "glm-5.3-flash"
    },
    {
      "provider": "opencode-go",
      "model": "deepseek-v4.1-flash-free"
    },
    {
      "provider": "opencode-go",
      "model": "longcat-2.5-preview-free"
    }
  ],
  "pool": {
    "followActive": true,
    "onlyActiveWhenExpiring": false
  },
  "api_server": {
    "enabled": true,
    "port": 8642,
    "host": "0.0.0.0"
  },
  "restart": true,
  "profiles": {
    "kleve": {
      "enabled": true,
      "primary": {
        "provider": "opencode-go",
        "model": "beam-free"
      },
      "fallback": [
        {
          "provider": "opencode-go",
          "model": "glm-5.3-flash"
        },
        {
          "provider": "opencode-go",
          "model": "longcat-2.5-preview-free"
        }
      ],
      "pool": {
        "followActive": true,
        "onlyActiveWhenExpiring": false
      }
    }
  },
  "agent": {
    "reasoning_effort": "low",
    "api_max_retries": 2,
    "auto_recovery_cycles": 0,
    "max_turns": 12
  },
  "providers": {
    "opencode-go": {
      // 2026-10-21: 25/20 -> 15/8. Bei einem Stream-Stall kostete der 20-s-
      // Threshold plus 4 s Backoff bis zu 33 s pro Turn (Log 14:27).
      // 2026-10-23: stale 8 -> 12, agent.api_max_retries 1 -> 2. Bei 8 s + 1
      // Versuch endete ein gestallter Voice-Turn nach 10-15 s mit Stub statt
      // Antwort (errors.log 17:00:28).
      "request_timeout_seconds": 15,
      "stale_timeout_seconds": 12
    }
  },
  // WICHTIG: Die Liste muss ALLE sechs MCP-Server fuer den api_server enthalten
  // (HA-Assist UND Open WebUI) — fehlt einer, entfernt ein Apply ihn aus dem
  // Assist. Eine fruehere Fassung stand hier auf nur "mcp-homeassistant" --
  // ein Apply haette Notion/oCIS/Super-Productivity/Spotify aus dem Assist
  // entfernt.
  "platform_toolsets": {
    "api_server": [
      "mcp-super-productivity",
      "mcp-homeassistant",
      "mcp-ocis-private",
      "mcp-ocis-muellerconnect",
      "mcp-notion",
      "mcp-spotify"
    ]
  },
  // Voice-Route "hermes-voice" (opencode-go/glm-5.3-flash) wird hier in der
  // NATIVEN Form {"provider", "model"} gepflegt — genau so erwartet sie der
  // Hermes api_server. aehnelt bewusst nicht {"model": "provider/model"}.
  //
  // MODELLREGEL (2026-10-21, Messung bei 4,7k Kontext, identischer Prompt):
  //   glm-5.3-flash            2,4 s/Call   <- fuer Voice und Agent bevorzugen
  //   deepseek-v4.1-flash-free 8,6 s/Call
  //   beam-free                8,6 s/Call
  //   longcat-2.5-preview-free   (nicht gemessen, gleiche Free-Klasse)
  // Gratismodelle nicht fuer Voice/Assist einsetzen: 3,5x langsamer pro Call,
  // hohe Varianz bis 23 s. Nur als letzter Fallback.
  "platforms": {
    "api_server": {
      "extra": {
        "model_routes": {
          "hermes-voice": {
            "provider": "opencode-go",
            "model": "glm-5.3-flash"
          }
        }
      }
    }
  },
  "skills": {
