{
  "enabled": true,
  "primary": {
    "provider": "opencode",
    "model": "deepseek-v4.1-flash-free"
  },
  "fallback": [
    {
      "provider": "opencode-go",
      "model": "glm-5.3-flash"
    },
    {
      "provider": "opencode-go",
      "model": "longcat-2.5-preview-free"
    }
  ],
  "pool": {
    "followActive": true,
    "onlyActiveWhenExpiring": false
  },
  "api_server": {
    "enabled": true,
    "port": 8642,
    "host": "0.0.0.0"
  },
  "restart": true,
  "profiles": {
    "kleve": {
      "enabled": true,
      "primary": {
        "provider": "opencode-go",
        "model": "beam-free"
      },
      "fallback": [
        {
          "provider": "opencode-go",
          "model": "glm-5.3-flash"
        },
        {
          "provider": "opencode-go",
          "model": "longcat-2.5-preview-free"
        }
      ],
      "pool": {
        "followActive": true,
        "onlyActiveWhenExpiring": false
      }
    }
  },
  "agent": {
    "reasoning_effort": "low",
    "api_max_retries": 1,
    "auto_recovery_cycles": 0
  },
  "providers": {
    "opencode-go": {
      "request_timeout_seconds": 25,
      "stale_timeout_seconds": 20
    }
  },
  "platform_toolsets": {
    "api_server": [
      "mcp-homeassistant"
    ]
  },
  // Voice-Route "hermes-voice" (opencode-go/beam-free) wird bewusst NICHT hier
  // gepflegt: Hestia normalisiert model_routes auf {"model": "provider/model"},
  // Hermes api_server erwartet dagegen {provider, model} getrennt. Die Route
  // liegt daher nur live in /etc/docker/hermes/data/config.yaml; ein Merge mit
  // platforms:{} laesst sie unangetastet.
