{
  // Single Source of Truth für den aktiven Account. Hestia pflegt dieses Feld
  // (accounts.py → switch_account schreibt es atomar via GitHub Contents API),
  // der CI-Workflow verteilt den Key daraus in die Container.
  // Das gleichnamige Feld "active" im OpenBao-Secret secret/data/mcp/opencode-go
  // wird NICHT mehr gelesen/geschrieben — es bleibt nur historisch bestehen.
  "active": "default2",

  "checkIntervalSeconds": 300,          // Abfrageintervall der Quota (Sekunden)

  // Anzeige-Schwellen für die Panel-Karte "OpenCode Go — Budget"
  "display": {
    "barMetric": "used",                // used = Balken zeigt Verbrauch | free = Restbudget
    "warnBelowPercentFree": 50,         // gelbe Warnstufe ab hier
    "criticalBelowPercentFree": 10      // rote/kritische Stufe ab hier (0 = erschöpft)
  },

  "policy": {
    "mode": "auto",                    // auto | notify | off
    "switchWhenExhausted": true,       // 0 % frei / status "rate-limited" in irgendeinem Fenster
    "select": "most_headroom",
    "cooldownSeconds": 1800,               // Mindestabstand zwischen zwei Wechseln
    "balance": {
      "enabled": true,
      "windows": ["weekly", "monthly"],
      "maxSpreadPercentPoints": 25,    // aktives Konto > Ø der anderen + X Verbrauchs-pp
      "minHeadroomPercent": 30         // nur wechseln, wenn Zielkonto >= X % frei hat
    },
    // "use it or lose it": bald zurücksetzendes Abo bevorzugen und allein nutzen
    "expiring": {
      "enabled": true,
      "withinHours": 24,               // "bald" = Reset in <= X Stunden
      "windows": ["weekly", "monthly"], // welche Fenster zählen (NICHT rolling/5h)
      "minRemainingPercent": 5          // nur bevorzugen, wenn noch X % frei sind
    }
  },
  "providers": {
    "opencode-go": {
      "type": "http-json",
      "url": "https://opencode.ai/zen/go/v1/usage",
      "auth": "bearer",
      "windows": { "rolling": "rolling", "weekly": "weekly", "monthly": "monthly" }
    },
    "gemini": { "type": "placeholder" },
    "codex":  { "type": "placeholder" }
  },
  "accounts": [
    { "id": "default1", "label": "OpenCode Go #1", "provider": "opencode-go", "priority": 1, "keyRef": { "path": "secret/data/mcp/opencode-go", "field": "default1" } },
    { "id": "default2", "label": "OpenCode Go #2", "provider": "opencode-go", "priority": 2, "keyRef": { "path": "secret/data/mcp/opencode-go", "field": "default2" } },
    { "id": "default3", "label": "OpenCode Go #3", "provider": "opencode-go", "priority": 3, "keyRef": { "path": "secret/data/mcp/opencode-go", "field": "default3" } }
  ]
}
