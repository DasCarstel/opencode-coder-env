{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "../../../skills/server",
    "../../../skills/shared"
  ],
  "mcp": {
    "servers": {
      "authentik": {
        "type": "local",
        "command": [
          "/root/.local/bin/uvx",
          "--extra-index-url",
          "https://nikitatsym.github.io/authentik-mcp/simple",
          "authentik-mcp"
        ],
        "environment": {
          "AUTHENTIK_URL": "https://auth.mueller-nas.de",
          "AUTHENTIK_TOKEN": "{env:AUTHENTIK_API_KEY}"
        }
      }
    }
  }
}
