{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "../../../skills/shared",
    "../../../skills/obsidian",
    "../../../skills/server/docker-host",
    "../../../skills/server/docker-host-compose",
    "../../../skills/server/docker-host-filesystem",
    "../../../skills/server/docker-host-git"
  ],
  "mcp": {
    "servers": {
      "ocis": {
        "type": "local",
        "command": [
          "/root/.local/bin/ocis-mcp-server"
        ],
        "environment": {
          "OCIS_MCP_OCIS_URL": "https://opencloud.mueller-nas.de",
          "OCIS_MCP_APP_TOKEN_USER": "{env:OCIS_PRIVATE_USER}",
          "OCIS_MCP_APP_TOKEN_VALUE": "{env:OCIS_PRIVATE_TOKEN}"
        }
      },
      "svelte": {
        "type": "remote",
        "url": "https://mcp.svelte.dev/mcp"
      }
    }
  }
}
