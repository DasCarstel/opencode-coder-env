{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "../../../skills/shared",
    "../../../skills/server/docker-host-location",
    "../../../skills/obsidian",
    "../../../skills/grafana"
  ],
  "mcp": {
    "servers": {
      "grafana": {
        "type": "local",
        "command": [
          "/root/.local/bin/mcp-grafana"
        ],
        "environment": {
          "GRAFANA_URL": "https://grafana.mueller-nas.de",
          "GRAFANA_SERVICE_ACCOUNT_TOKEN": "{env:GRAFANA_API_KEY}",
          "GRAFANA_USAGE_STATS": "disabled"
        }
      },
      "ocis": {
        "type": "local",
        "command": [
          "/root/.local/bin/ocis-mcp-server"
        ],
        "environment": {
          "OCIS_MCP_OCIS_URL": "https://opencloud.mueller-nas.de",
          "OCIS_MCP_APP_TOKEN_USER": "{env:OCIS_PRIVATE_USER}",
          "OCIS_MCP_APP_TOKEN_VALUE": "{env:OCIS_PRIVATE_TOKEN}"
        }
      },
      "ssh-mcp": {
        "type": "local",
        "command": [
          "ssh-mcp",
          "--config=/root/.config/ssh-mcp/config-full.toml"
        ]
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}
