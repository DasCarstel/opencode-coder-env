{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "../../skills/shared",
    "../../skills/uni/fernuni-stack",
    "../../skills/uni/fernuni-sync"
  ],
  "plugins": ["opencode-model-router", "@tarquinen/opencode-dcp"],
  "mcp": {
    "servers": {
      "ocis": {
        "type": "local",
        "command": [
          "/root/.local/bin/ocis-mcp-server"
        ],
        "environment": {
          "OCIS_MCP_OCIS_URL": "{env:FERNUNI_OCIS_BASE}",
          "OCIS_MCP_APP_TOKEN_USER": "{env:FERNUNI_OCIS_USER}",
          "OCIS_MCP_APP_TOKEN_VALUE": "{env:FERNUNI_OCIS_TOKEN}"
        }
      },
      "pdf": {
        "type": "local",
        "command": ["npx", "-y", "@sylphx/anymd@8.5.1"]
      }
    }
  }
}
