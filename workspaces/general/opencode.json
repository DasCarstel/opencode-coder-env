{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "super-productivity": {
        "type": "remote",
        "url": "https://mcp-superproductivity.mueller-nas.de/mcp",
        "headers": {
          "Authorization": "Bearer {env:SP_MCP_TOKEN}",
          "Accept": "application/json"
        }
      }
    }
  },
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  }
}
