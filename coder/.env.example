# Coder Environment Variables — VORLAGE (nur Platzhalter!)
#
# Diese Datei gehört ins Repo, die echte `.env` gehört NUR auf den Coder-Host
# (/opt/docker-compose/coder/.env). Die echte `.env` enthält Secrets
# (Postgres-Passwort, OIDC-Client-Secret, Token-Encryption-Keys) und darf
# niemals ins Repository, weder im Klartext noch in einem Commit.
#
# Kopieren und anpassen:
#   cp .env.example .env   && $EDITOR .env
#
# Der Deploy-Workflow schließt `.env` beim rsync explizit aus — der Host-Stand
# bleibt beim Deploy erhalten.

# ── PostgreSQL (Datenbank `database` = coder-postgres) ────────────────────────
POSTGRES_USER=coder
POSTGRES_PASSWORD=            # Platzhalter: eigenes Passwort setzen
POSTGRES_DB=coder

# ── Coder-Server ─────────────────────────────────────────────────────────────
# Muss von den Workspaces erreichbar sein — die Traefik-URL.
CODER_ACCESS_URL=https://coder.example.invalid
CODER_WILDCARD_ACCESS_URL=*-coder.example.invalid

# HTTP-Adresse, auf der der Server im Container lauscht (Port-Mapping 7080).
CODER_HTTP_ADDRESS=0.0.0.0:7080

# Vollständige Postgres-URL des Coder-Servers. Platzhalter muss ersetzt werden:
# Passwort URL-enkodieren (Sonderzeichen als %XX).
CODER_PG_CONNECTION_URL=postgres://<user>:<password>@database:5432/<database>?sslmode=disable

# ── OIDC / Authentik ─────────────────────────────────────────────────────────
CODER_OIDC_ISSUER_URL=https://authentik.example.invalid/application/o/<slug>/
CODER_OIDC_EMAIL_DOMAIN=example.invalid
CODER_OIDC_CLIENT_ID=coder-client-placeholder
CODER_OIDC_CLIENT_SECRET=       # Platzhalter: Client-Secret aus Authentik
CODER_OIDC_SCOPES=openid profile email
# true deaktiviert die Prüfung des Verifiziert-Flags beim OIDC-Login.
CODER_OIDC_IGNORE_EMAIL_VERIFIED=false

# Text und Icon auf dem Login-Knopf (Authentik-Logo als URL, sichtbar für alle).
CODER_OIDC_SIGN_IN_TEXT=Sign in with SSO
CODER_OIDC_ICON_URL=https://authentik.example.invalid/static/dist/icon.png

# Optional: Passwort-Login abschalten, nur OIDC.
# CODER_DISABLE_PASSWORD_AUTH=true

# ── Sessions / Token-Lebensdauer ─────────────────────────────────────────────
# 32-Byte-Schlüssel als Hex (64 Zeichen). Pro Platzhalter EIN eigener Wert —
# mehrere Einträge kommagetrennt für Key-Rotation (ältester zuerst).
CODER_EXTERNAL_TOKEN_ENCRYPTION_KEYS=

# Lebensdauer eines Admin-Login-Tokens: 8760h = 365 Tage.
CODER_MAX_ADMIN_TOKEN_LIFETIME=8760h
# Lebensdauer normaler Session-Tokens: 720h = 30 Tage.
CODER_DEFAULT_TOKEN_LIFETIME=720h